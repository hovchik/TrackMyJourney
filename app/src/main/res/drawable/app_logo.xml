<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="240dp"
    android:height="240dp"
    android:viewportWidth="240"
    android:viewportHeight="240">

    <!-- ══════════════════════════════════════════════════
         Modern "Track My Journey" app logo
         240x240 with built-in circular background
         Design: gradient circle + bold pin + flowing route
         ══════════════════════════════════════════════════ -->

    <!-- Circular gradient background -->
    <path android:pathData="M120,120m-100,0a100,100 0,1 1,200 0a100,100 0,1 1,-200 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="85"
                android:centerY="85"
                android:gradientRadius="140"
                android:startColor="#FF1FAF80"
                android:endColor="#FF0C5E3D" />
        </aapt:attr>
    </path>

    <!-- Subtle glow ring behind the pin -->
    <path
        android:pathData="M120,96m-62,0a62,62 0 1,0 124,0a62,62 0 1,0 -124,0"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.07" />

    <!-- Journey route trail — flowing curve from bottom-left toward pin -->
    <path
        android:pathData="M49,182 C61,164 75,152 88,140 C102,128 110,122 120,114"
        android:strokeWidth="7.5"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.50"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Route start dot (origin) -->
    <path
        android:pathData="M49,182 A8.5,8.5 0 1,1 49.01,182Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.55" />

    <!-- Waypoint dot on the trail -->
    <path
        android:pathData="M84,144 A5.5,5.5 0 1,1 84.01,144Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.45" />

    <!-- Journey continuation from pin toward top-right -->
    <path
        android:pathData="M138,62 C146,53 157,49 173,44"
        android:strokeWidth="7.5"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.50"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Direction arrowhead at route end -->
    <path
        android:pathData="M162,52 L173,44 L166,38"
        android:strokeWidth="5.5"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.50"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- ── Main location pin (hero element) ── -->
    <path
        android:pathData="M120,133 C120,133 84,111 84,80 C84,60.1 100.1,44 120,44 C139.9,44 156,60.1 156,80 C156,111 120,133 120,133Z"
        android:fillColor="#FFFFFF" />

    <!-- Pin inner ring (precision/crosshair feel) -->
    <path
        android:pathData="M120,80m-18,0a18,18 0 1,0 36,0a18,18 0 1,0 -36,0"
        android:strokeWidth="5.5"
        android:strokeColor="#0F6B45"
        android:fillColor="#00000000" />

    <!-- Pin center dot -->
    <path
        android:pathData="M120,80 A7.5,7.5 0 1,1 120.01,80Z"
        android:fillColor="#0F6B45" />

</vector>
