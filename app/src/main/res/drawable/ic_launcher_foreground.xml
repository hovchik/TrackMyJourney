<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ══════════════════════════════════════════════════
         Modern "Track My Journey" adaptive icon foreground
         Safe zone: ~21 to ~87 (66x66 center area)
         Design: Bold pin + flowing route + direction arrow
         ══════════════════════════════════════════════════ -->

    <!-- Subtle glow ring behind the pin for depth -->
    <path
        android:pathData="M54,44m-28,0a28,28 0 1,0 56,0a28,28 0 1,0 -56,0"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.07" />

    <!-- Journey route trail — flowing curve from bottom-left toward pin -->
    <path
        android:pathData="M22,82 C28,74 34,68 40,63 C46,58 50,55 54,51"
        android:strokeWidth="3.5"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.50"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Route start dot (origin) -->
    <path
        android:pathData="M22,82 A4,4 0 1,1 22.01,82Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.55" />

    <!-- Waypoint dot on the trail -->
    <path
        android:pathData="M38,65 A2.5,2.5 0 1,1 38.01,65Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.45" />

    <!-- Journey continuation from pin toward top-right -->
    <path
        android:pathData="M62,28 C66,24 71,22 78,20"
        android:strokeWidth="3.5"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.50"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Direction arrowhead at route end (movement indicator) -->
    <path
        android:pathData="M73,24 L78,20 L75,17"
        android:strokeWidth="2.5"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.50"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- ── Main location pin (hero element) ── -->
    <!-- Teardrop/pin shape: circle at top, point at bottom -->
    <path
        android:pathData="M54,60 C54,60 38,50 38,36 C38,27.2 45.2,20 54,20 C62.8,20 70,27.2 70,36 C70,50 54,60 54,60Z"
        android:fillColor="#FFFFFF" />

    <!-- Pin inner ring (precision/crosshair feel) -->
    <path
        android:pathData="M54,36m-8,0a8,8 0 1,0 16,0a8,8 0 1,0 -16,0"
        android:strokeWidth="2.5"
        android:strokeColor="#0F6B45"
        android:fillColor="#00000000" />

    <!-- Pin center dot -->
    <path
        android:pathData="M54,36 A3.5,3.5 0 1,1 54.01,36Z"
        android:fillColor="#0F6B45" />

</vector>
